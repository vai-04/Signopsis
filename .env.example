SETU_HOST=127.0.0.1
SETU_PORT=8000
SETU_LLM_URL=http://127.0.0.1:8081
SETU_LLM_MODEL_Q5=data/models/qwen3-4b-instruct-q5_k_m.gguf
SETU_LLM_MODEL_Q4=data/models/qwen3-4b-instruct-q4_k_m.gguf
SETU_QDRANT_URL=http://127.0.0.1:6333
SETU_VISION=backend            # backend | browser
SETU_FALLBACK=off              # off | cpu
SETU_CLOUD=off                 # off | groq  (free tier, text only)
GROQ_API_KEY=
SETU_LANGFUSE=off
SETU_SIGN_LANG=isl
SETU_SPOKEN_LANGS=en,hi,ta
SETU_GATE_EMIT=0.75
SETU_GATE_REPAIR=0.40
SETU_TRACE_DIR=data/traces

# --- Phase 2 (speech -> text) ---
SETU_MODEL_DIR=data/models
SETU_ASR=parakeet              # parakeet | whisper | fake
SETU_DIARIZER=sortformer       # sortformer | none
SETU_VAD=silero                # silero | energy
SETU_STORE_TRANSCRIPTS=off     # on = caption text is also written to trace files

# --- Layer 2 (text -> sign) ---
SETU_SIGN_OUTPUT=on            # on = emitted speech captions are also turned into ISL signing
SETU_SIGN_FRAMES=on            # on = send avatar landmark frames with each sign plan
SETU_SIGN_RESOLVER=rules       # rules | llm  (llm = Qwen3 via llama-server at SETU_LLM_URL, validated, rules fallback)
SETU_SIGN_LLM_TIMEOUT_S=2.5
