# ---- SIGNOPSIS frontend configuration ----
# mock  : everything runs in the browser from recorded backend fixtures (default, no server needed)
# live  : talk to the FastAPI backend
# auto  : try the backend's /healthz first, fall back to mock if it isn't reachable
VITE_BACKEND_MODE=auto

# Where the backend lives. Leave VITE_API_BASE empty in dev: Vite proxies /api, /ws, /healthz to VITE_BACKEND_ORIGIN.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
VITE_API_BASE=
# WebSocket URL for the live sign->text session. Empty = same origin as the page (/ws/sign).
VITE_WS_URL=

# Default user id used for personal signs (/api/users/{user}/signs and /ws/sign?user=)
VITE_DEFAULT_USER=demo
